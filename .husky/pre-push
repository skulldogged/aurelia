#!/bin/bash

# Pre-push hook to update version before pushing
# This ensures the pushed commit has the correct version

# Skip if we're already in the middle of a version update
if [ -f ".version-update-in-progress" ]; then
    echo "Version update already in progress, skipping"
    rm -f .version-update-in-progress
    exit 0
fi

echo "Running pre-push version update..."

touch .version-update-in-progress

bun run post-commit-update-version

cargo check --quiet --manifest-path src-tauri/Cargo.toml

git add src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/tauri.conf.json

git commit --amend --no-edit --no-verify

rm -f .version-update-in-progress

echo "Commit amended with updated version before push."