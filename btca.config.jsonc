{
	"$schema": "https://btca.dev/btca.schema.json",
	"resources": [
		{
			"name": "vue",
			"type": "git",
			"url": "https://github.com/vuejs/core",
			"branch": "main"
		},
		{
			"name": "vite",
			"type": "git",
			"url": "https://github.com/vitejs/vite",
			"branch": "main",
			"searchPath": "packages/vite"
		},
		{
			"name": "tailwind",
			"type": "git",
			"url": "https://github.com/tailwindlabs/tailwindcss.com",
			"branch": "main",
			"searchPath": "src/docs",
			"specialNotes": "Tailwind CSS documentation website."
		},
		{
			"name": "tauri",
			"type": "git",
			"url": "https://github.com/tauri-apps/tauri",
			"branch": "v2",
			"searchPath": "core/tauri",
			"specialNotes": "Tauri v2 core."
		},
		{
			"name": "pinia",
			"type": "git",
			"url": "https://github.com/vuejs/pinia",
			"branch": "v3",
			"searchPath": "packages/pinia"
		},
		{
			"name": "vueRouter",
			"type": "git",
			"url": "https://github.com/vuejs/router",
			"branch": "main",
			"searchPath": "packages/router"
		},
		{
			"name": "vueUse",
			"type": "git",
			"url": "https://github.com/vueuse/vueuse",
			"branch": "main",
			"searchPath": "packages/core"
		},
		{
			"name": "tanstackVirtual",
			"type": "git",
			"url": "https://github.com/TanStack/virtual",
			"branch": "main",
			"searchPath": "packages/vue-virtual"
		},
		{
			"name": "typescript",
			"type": "git",
			"url": "https://github.com/microsoft/TypeScript",
			"branch": "main"
		},
		{
			"name": "tokio",
			"type": "git",
			"url": "https://github.com/tokio-rs/tokio",
			"branch": "master"
		},
		{
			"name": "rodio",
			"type": "git",
			"url": "https://github.com/RustAudio/rodio",
			"branch": "master"
		},
		{
			"name": "media3",
			"type": "git",
			"url": "https://github.com/androidx/media",
			"branch": "main"
		},
		{
			"name": "coil",
			"type": "git",
			"url": "https://github.com/coil-kt/coil",
			"branch": "main"
		},
		{
			"name": "okhttp",
			"type": "git",
			"url": "https://github.com/square/okhttp",
			"branch": "master"
		},
		{
			"name": "kotlinCoroutines",
			"type": "git",
			"url": "https://github.com/Kotlin/kotlinx.coroutines",
			"branch": "master"
		},
		{
			"name": "jellyfin",
			"type": "git",
			"url": "https://github.com/jellyfin/jellyfin",
			"branch": "master",
			"specialNotes": "Jellyfin media server API source code"
		},
		{
			"name": "graphics-shapes",
			"type": "git",
			"url": "https://github.com/androidx/androidx",
			"branch": "androidx-main",
			"searchPath": "graphics/graphics-shapes",
			"specialNotes": "AndroidX graphics-shapes library for M3 Expressive shapes like Puffy, Cookie, Clover, etc."
		}
	],
	"model": "big-pickle",
	"provider": "opencode",
	"providerTimeoutMs": 300000
}
