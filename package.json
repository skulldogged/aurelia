{
  "name": "aurelia",
  "version": "0.1.0",
  "private": true,
  "description": "Aurelia music player - Desktop and Web applications",
  "type": "module",
  "scripts": {
    "verify:structure": "bash ./scripts/verify-structure.sh",
    "bindings:generate": "scripts/generate-bindings.sh --skip-ios",
    "bindings:generate:full": "scripts/generate-bindings.sh --ios",
    "bindings:verify": "scripts/verify-generated.sh --skip-ios",
    "bindings:verify:full": "scripts/verify-generated.sh --ios",
    "dev": "bun run scripts/aurelia.ts dev",
    "dev:web": "bun run scripts/aurelia.ts dev --platform=web",
    "dev:desktop": "bun run scripts/aurelia.ts dev --platform=desktop",
    "dev:desktop:tauri": "bun run scripts/aurelia.ts dev --platform=desktop-tauri",
    "build": "bun run build:web",
    "build:web": "bun run scripts/aurelia.ts build --platform=web --fast",
    "build:web:release": "bun run scripts/aurelia.ts build --platform=web",
    "build:web:strict": "bun run typecheck:web && bun run build:web",
    "build:desktop": "bun run scripts/aurelia.ts build --platform=desktop --fast",
    "build:desktop:release": "bun run scripts/aurelia.ts build --platform=desktop",
    "build:desktop:strict": "bun run typecheck:desktop && bun run build:desktop",
    "build:desktop:tauri": "bun run scripts/aurelia.ts build --platform=desktop-tauri --fast",
    "build:desktop:tauri:release": "bun run scripts/aurelia.ts build --platform=desktop-tauri",
    "typecheck": "bun run typecheck:web && bun run typecheck:desktop",
    "typecheck:web": "bun run --cwd apps/web/frontend typecheck",
    "typecheck:desktop": "bun run --cwd apps/desktop/tauri typecheck",
    "test": "bun run test:js && cargo test --workspace",
    "test:android": "cd apps/mobile/android && ./gradlew test",
    "test:android:ui": "cd apps/mobile/android && ./gradlew connectedAndroidTest",
    "test:desktop": "bun run --cwd apps/desktop/tauri test",
    "test:ios": "cd apps/mobile/ios && ./build-rust.sh && cd AureliaCore && swift test",
    "test:js": "bun run test:shared && bun run test:web && bun run test:desktop",
    "test:rust": "cargo test --workspace",
    "test:shared": "bun run --cwd apps/shared test",
    "test:web": "bun run --cwd apps/web/frontend test"
  },
  "workspaces": [
    "apps/*",
    "apps/desktop/*",
    "apps/web/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-perfectionist": "^5.5.0",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.3.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
