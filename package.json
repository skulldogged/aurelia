{
  "name": "aurelia",
  "version": "0.1.0",
  "private": true,
  "description": "Aurelia music player - Desktop and Web applications",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/aurelia.ts dev",
    "dev:web": "bun run scripts/aurelia.ts dev --platform=web",
    "dev:desktop": "bun run scripts/aurelia.ts dev --platform=desktop",
    "dev:android": "bun run scripts/aurelia.ts dev --platform=android",
    "build": "bun run scripts/aurelia.ts build",
    "build:web": "bun run scripts/aurelia.ts build --platform=web",
    "build:desktop": "bun run scripts/aurelia.ts build --platform=desktop",
    "build:android": "bun run scripts/aurelia.ts build --platform=android",
    "generate-bindings": "bun run scripts/aurelia.ts dev --platform=web --skip-bindings && cargo run -p uniffi-bindgen -- all --out-dir apps/shared/src/generated && cargo build -p aurelia-api --features web",
    "generate-bindings:win": "powershell -File .\\scripts\\generate-bindings.ps1",
    "dev:web:legacy": "./scripts/dev-web.sh",
    "dev:web:win:legacy": "powershell -File .\\scripts\\dev-web.ps1"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-plugin-perfectionist": "^5.3.1",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^17.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
