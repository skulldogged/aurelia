{
  "name": "aurelia",
  "version": "0.1.0",
  "private": true,
  "description": "Aurelia music player - Desktop and Web applications",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/aurelia.ts dev",
    "dev:web": "bun run scripts/aurelia.ts dev --platform=web",
    "dev:desktop": "bun run scripts/aurelia.ts dev --platform=desktop",
    "dev:android": "bun run scripts/aurelia.ts dev --platform=android",
    "build": "bun run scripts/aurelia.ts build",
    "build:web": "bun run scripts/aurelia.ts build --platform=web",
    "build:desktop": "bun run scripts/aurelia.ts build --platform=desktop",
    "build:android": "bun run scripts/aurelia.ts build --platform=android",
    "test": "bun run test:js && cargo test --workspace",
    "test:android": "cd apps/mobile/android && ./gradlew test",
    "test:android:ui": "cd apps/mobile/android && ./gradlew connectedAndroidTest",
    "test:desktop": "bun --cwd apps/desktop test",
    "test:ios": "cd apps/mobile/ios/AureliaCore && swift test",
    "test:js": "bun run test:shared && bun run test:web && bun run test:desktop",
    "test:rust": "cargo test --workspace",
    "test:shared": "bun --cwd apps/shared test",
    "test:web": "bun --cwd apps/web/frontend test"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-perfectionist": "^5.4.0",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.3.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
