{
  "name": "aurelia",
  "version": "0.1.0",
  "private": true,
  "description": "Aurelia music player - Desktop and Web applications",
  "type": "module",
  "scripts": {
    "bindings": "cargo run -p uniffi-bindgen -- all --out-dir apps/shared/src/generated && cargo check -p aurelia-api --features web",
    "bindings:full": "bun run bindings && (cd apps/mobile/ios && ./build-rust.sh)",

    "build": "bun run scripts/aurelia.ts build --platform=all",
    "build:web": "bun run scripts/aurelia.ts build --platform=web",
    "build:web:release": "bun run scripts/aurelia.ts build --platform=web",
    "build:web:strict": "bun run scripts/aurelia.ts typecheck --platform=web && bun run scripts/aurelia.ts build --platform=web",
    "build:desktop": "bun run scripts/aurelia.ts build --platform=desktop --fast",
    "build:desktop:release": "bun run scripts/aurelia.ts build --platform=desktop",
    "build:desktop:strict": "bun run scripts/aurelia.ts typecheck --platform=desktop && bun run scripts/aurelia.ts build --platform=desktop",
    "build:android": "bun run scripts/aurelia.ts build --platform=android",
    "build:android:release": "cd apps/mobile/android && ./gradlew assembleRelease",
    "build:ios": "bun run scripts/aurelia.ts build --platform=ios",
    "build:ios:ipa": "bun install && bun run scripts/aurelia.ts bindings && (cd apps/mobile/ios && ./build-rust.sh --release) && xcodebuild archive -workspace apps/mobile/ios/Aurelia.xcworkspace -scheme Aurelia -configuration Release -destination 'generic/platform=iOS' -archivePath build/ios.xcarchive CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO && mkdir -p build/ios-payload/Payload && cp -r build/ios.xcarchive/Products/Applications/Aurelia.app build/ios-payload/Payload/ && cd build/ios-payload && zip -r ../Aurelia.ipa Payload",

    "dev": "bun run scripts/aurelia.ts dev --platform=web",
    "dev:web": "bun run scripts/aurelia.ts dev --platform=web",
    "dev:desktop": "bun run scripts/aurelia.ts dev --platform=desktop",
    "dev:android": "bun run scripts/aurelia.ts dev --platform=android",
    "dev:ios": "bun run scripts/aurelia.ts dev --platform=ios",
    "dev:all": "bun run scripts/aurelia.ts dev --platform=all",

    "format": "bun run format:js && bun run format:rust && bun run format:kotlin && bun run format:swift",
    "format:js": "bun run lint:fix",
    "format:rust": "cargo fmt",
    "format:kotlin": "cd apps/mobile/android && ./gradlew ktlintFormat",
    "format:swift": "swiftformat --swift-version 6 apps/mobile/ios/Aurelia",

    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",

    "test": "bun run scripts/aurelia.ts test --platform=all",
    "test:web": "bun run scripts/aurelia.ts test --platform=web",
    "test:desktop": "bun run scripts/aurelia.ts test --platform=desktop",
    "test:android": "bun run scripts/aurelia.ts test --platform=android",
    "test:ios": "bun run scripts/aurelia.ts test --platform=ios",
    "test:js": "bun vitest run",
    "test:rust": "cargo test --workspace",

    "typecheck": "bun run scripts/aurelia.ts typecheck --platform=all",
    "typecheck:web": "bun run scripts/aurelia.ts typecheck --platform=web",
    "typecheck:desktop": "bun run scripts/aurelia.ts typecheck --platform=desktop"
  },
  "workspaces": [
    "apps/*",
    "apps/desktop/*",
    "apps/web/*"
  ],
  "dependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "@effect/platform": "^0.94.3",
    "@effect/platform-browser": "^0.74.0",
    "@effect/schema": "^0.75.5",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/vue-virtual": "^3.13.18",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "culori": "^4.0.2",
    "effect": "^3.19.16",
    "fuse.js": "^7.1.0",
    "lucide-vue-next": "^0.562.0",
    "overlayscrollbars": "^2.13.0",
    "overlayscrollbars-vue": "^0.5.9",
    "pinia": "^3.0.4",
    "reka-ui": "^2.7.0",
    "simple-icons": "^16.5.0",
    "sortablejs-vue3": "^1.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "unplugin-vue-router": "^0.19.2",
    "uuid": "^13.0.0",
    "vite": "^7.3.1",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@effect/vitest": "^0.27.0",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/vue": "^8.1.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.2",
    "eslint-plugin-perfectionist": "^5.5.0",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.3.0",
    "happy-dom": "^16.8.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.1.1",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
