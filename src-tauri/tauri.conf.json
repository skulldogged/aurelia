{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jellyfin-music-player",
  "version": "1.0.0",
  "identifier": "dev.pupbrained.jellyfin-music-player",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Jellyfin Music Player",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}