<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group android:name="icon_group">
                <path
                    android:name="left_bar"
                    android:pathData="M6,5 L10,5 L10,19 L6,19 Z"
                    android:fillColor="#FFFFFF" />
                <path
                    android:name="right_bar"
                    android:pathData="M14,5 L18,5 L18,19 L14,19 Z"
                    android:fillColor="#FFFFFF" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="left_bar">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:valueFrom="M6,5 L10,5 L10,19 L6,19 Z"
                android:valueTo="M8,5 L19,12 L19,12 L8,19 Z"
                android:valueType="pathType"
                android:duration="200"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="right_bar">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:valueFrom="M14,5 L18,5 L18,19 L14,19 Z"
                android:valueTo="M8,5 L19,12 L19,12 L8,19 Z"
                android:valueType="pathType"
                android:duration="200"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

</animated-vector>
