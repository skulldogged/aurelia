{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
"paths": {
      "@/*": [
        "src/*"
      ],
      "@shared": [
        "../shared/src"
      ],
      "@shared/*": [
        "../shared/src/*"
      ]
    },
    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "./typed-router.d.ts",
    "../shared/src/**/*.ts",
    "../shared/src/**/*.d.ts",
    "../shared/src/**/*.vue"
  ],

  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],

  "exclude": [
    "src/bindings.ts"
  ]
}
