{
  "db_name": "SQLite",
  "query": "\n        SELECT\n            a.id,\n            a.name,\n            ar.name as \"artist\",\n            a.artist_id,\n            a.album_art_url,\n            (SELECT COUNT(*) FROM songs s WHERE s.album_id = a.id) as \"song_count: i32\"\n        FROM albums a\n        LEFT JOIN artists ar ON a.artist_id = ar.id\n        ORDER BY a.name\n        ",
