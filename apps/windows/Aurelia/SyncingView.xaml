<Page
    x:Class="Aurelia.SyncingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="SyncingView_Loaded">

    <Grid Padding="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
            <TextBlock
                Text="Aurelia"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,8" />

            <TextBlock
                x:Name="StatusText"
                Text="Syncing your library…"
                FontSize="14"
                Opacity="0.7"
                HorizontalAlignment="Center"
                Margin="0,0,0,24" />

            <ProgressBar
                x:Name="SyncProgressBar"
                IsIndeterminate="True"
                Minimum="0"
                Maximum="100"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,8" />

            <TextBlock
                x:Name="CountText"
                FontSize="12"
                Opacity="0.5"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
