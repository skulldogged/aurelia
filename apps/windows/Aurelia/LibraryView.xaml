<Page
    x:Class="Aurelia.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aurelia">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,24,24,12">
            <TextBlock 
                FontSize="28" 
                FontWeight="Bold" 
                Text="Library" />
        </StackPanel>

        <Pivot Grid.Row="1" x:Name="LibraryPivot">
            <PivotItem Header="Songs">
                <ListView 
                    x:Name="SongsList"
                    ItemClick="Song_Click"
                    IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border 
                                    Grid.Column="0"
                                    Width="40" 
                                    Height="40" 
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                    CornerRadius="4"
                                    Margin="0,0,12,0">
                                    <Image Source="{Binding albumArtUrl, Converter={StaticResource ImageSizeConverter}, ConverterParameter=80}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding name}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding album}"
                                        FontSize="12"
                                        Opacity="0.7"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock 
                                    Grid.Column="2"
                                    Text="{Binding duration, Converter={StaticResource DurationConverter}}"
                                    Opacity="0.5"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="Albums">
                <GridView 
                    x:Name="AlbumsGrid"
                    ItemClick="Album_Click"
                    IsItemClickEnabled="True">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="160">
                                <Border 
                                    Width="160" Height="160" 
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                    CornerRadius="8"
                                    Margin="0,0,0,8">
                                    <Image Source="{Binding albumArtUrl, Converter={StaticResource ImageSizeConverter}, ConverterParameter=240}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock 
                                    Text="{Binding name}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock 
                                    Text="{Binding artist}"
                                    FontSize="12"
                                    Opacity="0.7"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>

            <PivotItem Header="Artists">
                <GridView 
                    x:Name="ArtistsGrid"
                    ItemClick="Artist_Click"
                    IsItemClickEnabled="True">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="160">
                                <Border 
                                    Width="160" Height="160" 
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                    CornerRadius="80"
                                    Margin="0,0,0,8">
                                    <Image Source="{Binding imageUrl}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock 
                                    Text="{Binding name}"
                                    FontWeight="SemiBold"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>

            <PivotItem Header="Playlists">
                <GridView 
                    x:Name="PlaylistsGrid"
                    ItemClick="Playlist_Click"
                    IsItemClickEnabled="True">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="160">
                                <Border 
                                    Width="160" Height="160" 
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                    CornerRadius="8"
                                    Margin="0,0,0,8">
                                    <Image Stretch="UniformToFill" />
                                </Border>
                                <TextBlock 
                                    Text="{Binding DisplayName}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="PlaylistSongCount"
                                    FontSize="12"
                                    Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </PivotItem>
        </Pivot>

        <ProgressBar 
            x:Name="LoadingIndicator"
            Grid.Row="1"
            IsIndeterminate="True"
            Visibility="Collapsed"
            VerticalAlignment="Top" />
    </Grid>
</Page>
