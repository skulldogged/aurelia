<Page
    x:Class="Aurelia.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aurelia">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="24,16,24,24" Spacing="24">

                <!-- Greeting Header -->
                <TextBlock
                    x:Name="GreetingText"
                    FontSize="32"
                    FontWeight="Bold"
                    Margin="0,8,0,0" />

                <!-- Featured Album Hero -->
                <Grid x:Name="FeaturedSection" Visibility="Collapsed">
                    <Border
                        Height="220"
                        CornerRadius="12">
                        <Border.Background>
                            <ImageBrush
                                x:Name="FeaturedBackdrop"
                                Stretch="UniformToFill"
                                Opacity="0.4" />
                        </Border.Background>
                    </Border>
                    <Border
                        Height="220"
                        CornerRadius="12"
                        Padding="24">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="{ThemeResource SystemAltHighColor}" Offset="0.8" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="120" Height="120" Margin="0,0,20,0">
                                <Border
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                    CornerRadius="8" />
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush
                                            x:Name="FeaturedArt"
                                            Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                                <TextBlock
                                    x:Name="FeaturedAlbumName"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2" />
                                <TextBlock
                                    x:Name="FeaturedArtistName"
                                    FontSize="14"
                                    Opacity="0.7"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                                <Button
                                    x:Name="FeaturedPlayButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="FeaturedPlay_Click"
                                    Padding="16,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                                        <TextBlock Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="FeaturedNextButton"
                                    Click="FeaturedNext_Click"
                                    ToolTipService.ToolTip="Next featured album"
                                    Padding="8">
                                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Most Played Songs -->
                <StackPanel x:Name="MostPlayedSection" Visibility="Collapsed" Spacing="12">
                    <TextBlock
                        Text="Most Played"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MostPlayedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Padding="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="MostPlayedSong_Click"
                                        Tag="{Binding}">
                                        <StackPanel Width="140" Spacing="6">
                                            <Grid Width="140" Height="140">
                                                <Border
                                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                                    CornerRadius="8" />
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush
                                                            ImageSource="{Binding albumArtUrl, Converter={StaticResource ImageSizeConverter}, ConverterParameter=200}"
                                                            Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <TextBlock
                                                Text="{Binding name}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                            <TextBlock
                                                Text="{Binding artists, Converter={StaticResource ArtistsConverter}}"
                                                FontSize="11"
                                                Opacity="0.6"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Recently Played Songs -->
                <StackPanel x:Name="RecentlyPlayedSection" Visibility="Collapsed" Spacing="12">
                    <TextBlock
                        Text="Recently Played"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecentlyPlayedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Padding="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RecentSong_Click"
                                        Tag="{Binding}">
                                        <StackPanel Width="140" Spacing="6">
                                            <Grid Width="140" Height="140">
                                                <Border
                                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                                    CornerRadius="8" />
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush
                                                            ImageSource="{Binding albumArtUrl, Converter={StaticResource ImageSizeConverter}, ConverterParameter=200}"
                                                            Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <TextBlock
                                                Text="{Binding name}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                            <TextBlock
                                                Text="{Binding artists, Converter={StaticResource ArtistsConverter}}"
                                                FontSize="11"
                                                Opacity="0.6"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Recently Added Albums -->
                <StackPanel x:Name="RecentlyAddedSection" Visibility="Collapsed" Spacing="12">
                    <TextBlock
                        Text="Recently Added"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecentlyAddedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Padding="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="Album_Click"
                                        Tag="{Binding}">
                                        <StackPanel Width="160" Spacing="6">
                                            <Grid Width="160" Height="160">
                                                <Border
                                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                                    CornerRadius="8" />
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush
                                                            ImageSource="{Binding albumArtUrl, Converter={StaticResource ImageSizeConverter}, ConverterParameter=240}"
                                                            Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <TextBlock
                                                Text="{Binding name}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                            <TextBlock
                                                Text="{Binding artist}"
                                                FontSize="12"
                                                Opacity="0.6"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- From Your Library (Random Albums) -->
                <StackPanel x:Name="RandomAlbumsSection" Visibility="Collapsed" Spacing="12">
                    <TextBlock
                        Text="From Your Library"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RandomAlbumsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Padding="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="Album_Click"
                                        Tag="{Binding}">
                                        <StackPanel Width="160" Spacing="6">
                                            <Grid Width="160" Height="160">
                                                <Border
                                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                                    CornerRadius="8" />
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush
                                                            ImageSource="{Binding albumArtUrl, Converter={StaticResource ImageSizeConverter}, ConverterParameter=240}"
                                                            Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                            <TextBlock
                                                Text="{Binding name}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                            <TextBlock
                                                Text="{Binding artist}"
                                                FontSize="12"
                                                Opacity="0.6"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Empty state when no data -->
                <StackPanel
                    x:Name="EmptyState"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Padding="0,48,0,0">
                    <FontIcon
                        Glyph="&#xE8D6;"
                        FontSize="48"
                        Opacity="0.4"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Your library is empty"
                        FontSize="16"
                        Opacity="0.6"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Sync your library to see your music here"
                        FontSize="13"
                        Opacity="0.4"
                        HorizontalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingIndicator"
            IsActive="False"
            Width="32" Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
