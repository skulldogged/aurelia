<UserControl
    x:Class="Aurelia.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aurelia">

    <Grid>
        <!-- Solid backdrop -->
        <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <Grid Padding="32" MaxWidth="500" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dismiss chevron -->
            <Button
                Grid.Row="0"
                Click="Dismiss_Click"
                HorizontalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Padding="16,4"
                Margin="0,0,0,16">
                <FontIcon Glyph="&#xE70D;" FontSize="18" />
            </Button>

            <Grid Grid.Row="1">
                <StackPanel x:Name="AlbumArtPanel" VerticalAlignment="Center">
                    <Grid
                        Width="280" Height="280"
                        Margin="0,0,0,32"
                        HorizontalAlignment="Center">
                        <Border
                            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="12" />
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush
                                    x:Name="AlbumArtBrush"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <TextBlock
                        x:Name="SongTitle"
                        FontSize="24"
                        FontWeight="Bold"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,0,0,8" />

                    <TextBlock
                        x:Name="SongArtist"
                        FontSize="16"
                        Opacity="0.7"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,0,0,8" />

                    <TextBlock
                        x:Name="SongAlbum"
                        FontSize="14"
                        Opacity="0.5"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <local:LyricsView
                    x:Name="LyricsViewControl"
                    Visibility="Collapsed" />
            </Grid>

            <StackPanel Grid.Row="2">
                <Slider
                    x:Name="ProgressSlider"
                    Maximum="100"
                    IsThumbToolTipEnabled="False"
                    PointerPressed="ProgressSlider_PointerPressed"
                    PointerCaptureLost="ProgressSlider_PointerCaptureLost"
                    ValueChanged="ProgressSlider_ValueChanged"
                    Margin="0,0,0,8" />

                <Grid Margin="0,0,0,16">
                    <TextBlock
                        x:Name="PositionText"
                        Text="0:00"
                        FontSize="12"
                        HorizontalAlignment="Left"
                        Opacity="0.7" />
                    <TextBlock
                        x:Name="DurationText"
                        Text="0:00"
                        FontSize="12"
                        HorizontalAlignment="Right"
                        Opacity="0.7" />
                </Grid>

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24">
                    <Button
                        x:Name="ShuffleButton"
                        Click="Shuffle_Click"
                        Margin="0,0,16,0">
                        <SymbolIcon Symbol="Shuffle" />
                    </Button>
                    <Button
                        x:Name="PreviousButton"
                        Click="Previous_Click"
                        Margin="0,0,16,0">
                        <SymbolIcon Symbol="Previous" />
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="PlayPause_Click"
                        Width="64" Height="64">
                        <SymbolIcon Symbol="Play" />
                    </Button>
                    <Button
                        x:Name="NextButton"
                        Click="Next_Click"
                        Margin="16,0,0,0">
                        <SymbolIcon Symbol="Next" />
                    </Button>
                    <Button
                        x:Name="RepeatButton"
                        Click="Repeat_Click"
                        Margin="16,0,0,0">
                        <SymbolIcon Symbol="RepeatAll" />
                    </Button>
                    <Button
                        x:Name="LyricsButton"
                        Click="Lyrics_Click"
                        Margin="16,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8">
                        <FontIcon x:Name="LyricsIcon" Glyph="&#xE8F2;" FontSize="16" Opacity="0.5" />
                    </Button>
                </StackPanel>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="MuteButton"
                        Grid.Column="0"
                        Click="Mute_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        VerticalAlignment="Center">
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE995;" FontSize="16" />
                    </Button>
                    <Slider
                        x:Name="VolumeSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="VolumeSlider_ValueChanged"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="VolumeText"
                        Grid.Column="2"
                        Text="100%"
                        FontSize="12"
                        Opacity="0.5"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Width="36" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
