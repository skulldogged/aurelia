<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Aurelia</RootNamespace>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType Condition="'$(Configuration)' == 'Debug'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(Configuration)' != 'Debug'">MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AureliaCore\AureliaCore.csproj" />
  </ItemGroup>

  <Target Name="BuildRustCore" BeforeTargets="Build">
    <PropertyGroup>
      <ProjectRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</ProjectRoot>
      <RustTargetDir Condition="'$(Configuration)' == 'Debug'">$(ProjectRoot)\target\debug</RustTargetDir>
      <RustTargetDir Condition="'$(Configuration)' != 'Debug'">$(ProjectRoot)\target\release</RustTargetDir>
      <RustDll>$(RustTargetDir)\aurelia_core.dll</RustDll>
    </PropertyGroup>
    <Message Text="Building Rust core..." Importance="high" />
    <Exec Command="cargo build -p aurelia-core --features desktop" Condition="'$(Configuration)' == 'Debug'" WorkingDirectory="$(ProjectRoot)" />
    <Exec Command="cargo build -p aurelia-core --release --features desktop" Condition="'$(Configuration)' != 'Debug'" WorkingDirectory="$(ProjectRoot)" />
    <Message Text="Rust core built successfully" Importance="high" />
  </Target>

  <Target Name="CopyRustDll" AfterTargets="Build">
    <PropertyGroup>
      <ProjectRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</ProjectRoot>
      <RustTargetDir Condition="'$(Configuration)' == 'Debug'">$(ProjectRoot)\target\debug</RustTargetDir>
      <RustTargetDir Condition="'$(Configuration)' != 'Debug'">$(ProjectRoot)\target\release</RustTargetDir>
      <RustDll>$(RustTargetDir)\aurelia_core.dll</RustDll>
    </PropertyGroup>
    <Message Text="Copying $(RustDll) to $(TargetDir)" Importance="high" />
    <Copy SourceFiles="$(RustDll)" DestinationFolder="$(TargetDir)" Condition="Exists('$(RustDll)')" SkipUnchangedFiles="true" />
    <Warning Text="Rust DLL not found at $(RustDll)" Condition="!Exists('$(RustDll)')" />
  </Target>
</Project>
