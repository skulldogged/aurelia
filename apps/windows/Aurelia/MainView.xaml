<Page
    x:Class="Aurelia.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aurelia">

    <Page.Resources>
        <Style x:Key="MiniPlayerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style x:Key="MiniPlayerButtonLarge" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Main content area -->
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" Icon="Home" />
                <NavigationViewItem Content="Library" Tag="Library" Icon="Library" />
                <NavigationViewItem Content="Search" Tag="Search" Icon="Find" />
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />

                <!-- Floating Mini Player -->
                <Border
                    x:Name="MiniPlayer"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    MaxWidth="768"
                    Height="64"
                    Margin="16,0,16,16"
                    Padding="16,0"
                    CornerRadius="32"
                    Visibility="Collapsed"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderThickness="0">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Playback controls -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Spacing="2">
                            <Button x:Name="MiniPlayerShuffle" Style="{StaticResource MiniPlayerButton}"
                                    Click="MiniPlayerShuffle_Click">
                                <FontIcon x:Name="MiniShuffleIcon" Glyph="&#xE8B1;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <Button x:Name="MiniPlayerPrevious" Style="{StaticResource MiniPlayerButton}"
                                    Click="MiniPlayerPrevious_Click">
                                <FontIcon Glyph="&#xE892;" FontSize="14" />
                            </Button>
                            <Button x:Name="MiniPlayerPlayPause" Style="{StaticResource MiniPlayerButtonLarge}"
                                    Click="MiniPlayerPlayPause_Click">
                                <FontIcon x:Name="MiniPlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                            </Button>
                            <Button x:Name="MiniPlayerNext" Style="{StaticResource MiniPlayerButton}"
                                    Click="MiniPlayerNext_Click">
                                <FontIcon Glyph="&#xE893;" FontSize="14" />
                            </Button>
                            <Button x:Name="MiniPlayerRepeat" Style="{StaticResource MiniPlayerButton}"
                                    Click="MiniPlayerRepeat_Click">
                                <FontIcon x:Name="MiniRepeatIcon" Glyph="&#xE8EE;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- Center: Album art + song info (tappable) -->
                        <Button
                            Grid.Column="1"
                            Click="MiniPlayerCenter_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,6"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Grid Width="44" Height="44">
                                    <Border
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="6" />
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush
                                                x:Name="MiniPlayerArtBrush"
                                                Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        x:Name="MiniPlayerTitle"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        MaxWidth="200" />
                                    <TextBlock
                                        x:Name="MiniPlayerArtist"
                                        FontSize="12"
                                        Opacity="0.6"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        MaxWidth="200" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Right: Lyrics, Queue, Favorite -->
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Spacing="4">
                            <Button
                                x:Name="MiniPlayerLyrics"
                                Click="MiniPlayerLyrics_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="36" Height="36"
                                Padding="0"
                                CornerRadius="18">
                                <FontIcon x:Name="MiniLyricsIcon" Glyph="&#xE8F2;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <Button
                                x:Name="MiniPlayerQueue"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="36" Height="36"
                                Padding="0"
                                CornerRadius="18"
                                IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" Opacity="0.4" />
                            </Button>
                            <Button
                                x:Name="MiniPlayerFavorite"
                                Click="MiniPlayerFavorite_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="36" Height="36"
                                Padding="0"
                                CornerRadius="18">
                                <FontIcon x:Name="MiniFavoriteIcon" Glyph="&#xEB51;" FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>

        <!-- Full Player Overlay -->
        <Grid
            x:Name="PlayerOverlay"
            Visibility="Collapsed">
            <local:PlayerView
                x:Name="PlayerControl"
                DismissRequested="PlayerControl_DismissRequested" />
        </Grid>
    </Grid>
</Page>
