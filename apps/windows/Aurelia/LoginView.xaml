<Page
    x:Class="Aurelia.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <StackPanel VerticalAlignment="Center" MaxWidth="400">
            <TextBlock 
                Text="Aurelia"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,8" />

            <TextBlock 
                Text="Sign in to your media server"
                FontSize="14"
                Opacity="0.7"
                HorizontalAlignment="Center"
                Margin="0,0,0,32" />

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Provider" Margin="0,0,0,6" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox x:Name="ProviderBox" SelectedIndex="0">
                        <ComboBoxItem Content="Auto-detect" />
                        <ComboBoxItem Content="Jellyfin" />
                        <ComboBoxItem Content="Navidrome" />
                    </ComboBox>
                    <Button 
                        Grid.Column="1"
                        x:Name="DetectProviderButton"
                        Content="Detect"
                        Click="DetectProvider_Click" />
                </Grid>
                <TextBlock
                    x:Name="DetectedProviderText"
                    FontSize="12"
                    Opacity="0.7"
                    Margin="0,6,0,0"
                    Visibility="Collapsed" />
            </StackPanel>

            <TextBox 
                x:Name="ServerUrlBox"
                PlaceholderText="Server URL (e.g., https://music.example.com)"
                Margin="0,0,0,12" />

            <TextBox 
                x:Name="UsernameBox"
                PlaceholderText="Username"
                Margin="0,0,0,12" />

            <PasswordBox 
                x:Name="PasswordBox"
                PlaceholderText="Password"
                Margin="0,0,0,24" />

            <Button 
                x:Name="LoginButton"
                Content="Sign In"
                Click="Login_Click"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,16" />

            <TextBlock 
                x:Name="ErrorText"
                Foreground="Red"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Visibility="Collapsed"
                Margin="0,0,0,16" />

            <ProgressBar 
                x:Name="LoadingIndicator"
                IsIndeterminate="True"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
