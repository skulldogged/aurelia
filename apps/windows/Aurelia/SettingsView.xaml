<Page
    x:Class="Aurelia.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <ScrollViewer>
            <StackPanel>
                <TextBlock 
                    FontSize="28" 
                    FontWeight="Bold" 
                    Text="Settings" 
                    Margin="0,0,0,24" />

                <TextBlock 
                    Text="Account"
                    FontSize="18" 
                    FontWeight="SemiBold" 
                    Margin="0,0,0,12" />

                <StackPanel Margin="0,0,0,24">
                    <TextBlock 
                        x:Name="UsernameText"
                        FontWeight="SemiBold" />
                    <TextBlock 
                        x:Name="ProviderText"
                        FontSize="12"
                        Opacity="0.7" />
                    <TextBlock 
                        x:Name="ServerUrlText"
                        FontSize="12"
                        Opacity="0.7" />
                </StackPanel>

                <TextBlock
                    Text="Add Profile"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12" />

                <StackPanel MaxWidth="460" Margin="0,0,0,24">
                    <TextBlock Text="Provider" Margin="0,0,0,6" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
                        <ComboBox x:Name="SwitchProviderBox" SelectedIndex="0">
                            <ComboBoxItem Content="Auto-detect" />
                            <ComboBoxItem Content="Jellyfin" />
                            <ComboBoxItem Content="Navidrome" />
                        </ComboBox>
                        <Button
                            Grid.Column="1"
                            x:Name="DetectSwitchProviderButton"
                            Content="Detect"
                            Click="DetectSwitchProvider_Click" />
                    </Grid>

                    <TextBlock
                        x:Name="DetectedSwitchProviderText"
                        FontSize="12"
                        Opacity="0.7"
                        Margin="0,0,0,10"
                        Visibility="Collapsed" />

                    <TextBox
                        x:Name="SwitchServerUrlBox"
                        PlaceholderText="Server URL"
                        Margin="0,0,0,10" />

                    <TextBox
                        x:Name="SwitchUsernameBox"
                        PlaceholderText="Username"
                        Margin="0,0,0,10" />

                    <PasswordBox
                        x:Name="SwitchPasswordBox"
                        PlaceholderText="Password"
                        Margin="0,0,0,10" />

                    <Button
                        x:Name="SwitchServerButton"
                        Content="Add Profile"
                        HorizontalAlignment="Left"
                        Click="SwitchServer_Click" />
                </StackPanel>

                <TextBlock
                    Text="Saved Profiles"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12" />

                <StackPanel
                    x:Name="ProfilesListPanel"
                    MaxWidth="600"
                    Margin="0,0,0,24" />

                <Button 
                    x:Name="LogoutButton"
                    Content="Log Out"
                    Click="Logout_Click"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,24" />

                <TextBlock 
                    Text="Library"
                    FontSize="18" 
                    FontWeight="SemiBold" 
                    Margin="0,24,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button 
                        x:Name="SyncButton"
                        Content="Sync Library"
                        Click="Sync_Click"
                        Margin="0,0,12,0" />
                    <Button 
                        x:Name="ClearCacheButton"
                        Content="Clear Cache"
                        Click="ClearCache_Click" />
                </StackPanel>

                <ProgressBar 
                    x:Name="SyncProgress"
                    IsIndeterminate="True"
                    Visibility="Collapsed"
                    Margin="0,0,0,12" />

                <TextBlock 
                    x:Name="SyncStatus"
                    Opacity="0.7"
                    Margin="0,0,0,24" />

                <TextBlock
                    Text="Lyrics"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Margin="0,24,0,4" />

                <TextBlock
                    Text="Lyrics daemon URL"
                    FontSize="13"
                    Opacity="0.7"
                    Margin="0,0,0,6" />

                <TextBox
                    x:Name="LyricsServerUrlBox"
                    PlaceholderText="http://localhost:3030"
                    MaxWidth="400"
                    HorizontalAlignment="Left"
                    TextChanged="LyricsServerUrl_TextChanged"
                    Margin="0,0,0,4" />

                <TextBlock
                    Text="Used to fetch synced lyrics from a local daemon (e.g. lrclib-server)."
                    FontSize="12"
                    Opacity="0.5"
                    Margin="0,0,0,24" />

                <TextBlock
                    Text="About"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Margin="0,24,0,12" />

                <TextBlock Text="Aurelia Music Player" />
                <TextBlock Text="Windows Edition" Opacity="0.7" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
