{
  "name": "@aurelia/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "build:strict": "bun run typecheck && bun run build",
    "preview": "bun --bun vite preview",
    "typecheck": "vue-tsc --build tsconfig.typecheck.json --pretty false",
    "test": "bun run ../../../scripts/run-vitest.ts",
    "test:watch": "bun run ../../../scripts/run-vitest.ts --watch"
  },
  "dependencies": {
    "@aurelia/shared": "file:../../shared"
  }
}
